# Bootcamp-only kubeconfig: work clusters in ~/.kube/config are not visible here.
# kind/k3d write their context into this file when a cluster is created.
mkdir -p .kube
export KUBECONFIG="$PWD/.kube/bootcamp.yaml"

# Local overrides (tokens, dev passwords) go in .envrc.local, which is gitignored.
source_env_if_exists .envrc.local
